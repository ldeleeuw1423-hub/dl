# Paper trading (standaard). Zet op true voor Kraken live orders.
LIVE_TRADING=false

# Verplicht bij LIVE_TRADING=true
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Optioneel — gratis account op cryptopanic.com
CRYPTOPANIC_KEY=

# Bot-instellingen (defaults zijn goed voor de meeste gebruikers)
START_BALANCE=10000
SCAN_INTERVAL=300
TOP_N_COINS=45
CANDLE_INTERVAL=5m
CANDLE_LIMIT=100
